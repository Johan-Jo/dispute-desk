{
  "name": "disputedesk",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }); } catch (e) {}\" && next dev",
    "shopify:dev": "node -e \"require('dotenv').config({ path: '.env.local' }); const cid = process.env.SHOPIFY_API_KEY; if (!cid) throw new Error('SHOPIFY_API_KEY missing in .env.local'); require('child_process').execSync('npx shopify@3.94.3 app dev --client-id ' + cid + ' --config=dev', { stdio: 'inherit', shell: true });\"",
    "shopify:deploy:dev": "node scripts/guard-shopify-config.mjs dev && npx shopify@3.94.3 app deploy --config=dev --allow-updates",
    "shopify:deploy:prod": "node scripts/guard-shopify-config.mjs prod && npx shopify@3.94.3 app deploy --config=prod --allow-updates",
    "prebuild": "node scripts/verify-env-identity.mjs && node scripts/build-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretest": "node scripts/build-pdf-worker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include=\"lib/automation/**\" --coverage.include=\"lib/packs/**\" --coverage.include=\"lib/shopify/**\" --coverage.exclude=\"**/__tests__/**\" --coverage.exclude=\"**/tests/**\" --coverage.exclude=\"**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:golden": "vitest run tests/golden",
    "test:visual": "playwright test e2e/visual",
    "release:verify": "node scripts/release-verify.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:i18n-keys": "node scripts/verify-i18n-keys.mjs",
    "seed:dev:shopify": "node scripts/shopify/seed-teststore.mjs",
    "seed:dev:synthetic-disputes": "node scripts/seed-synthetic-disputes.mjs --shop dev-store.myshopify.com --ensure-shop --count 20",
    "seed:dev:real-disputes": "node scripts/seed-real-disputes.mjs",
    "seed:content:resources": "node scripts/seed-resources-hub.mjs",
    "seed:content:resources:force": "node scripts/seed-resources-hub.mjs --force",
    "backfill:resources-images": "node scripts/backfill-resources-featured-images.mjs",
    "backfill:resources-images:dry": "node scripts/backfill-resources-featured-images.mjs --dry-run",
    "import:backlog": "node scripts/import-content-backlog.mjs",
    "seed:content:shopify-chargeback-cluster": "node scripts/seed-shopify-chargeback-cluster.mjs",
    "seed:content:tier-a-pillars": "node scripts/seed-tier-a-pillar-briefs.mjs",
    "run:autopilot-once": "node scripts/run-autopilot-once.mjs",
    "hub:expand": "node scripts/expand-thin-article.mjs",
    "hub:batch-expand": "node scripts/batch-expand.mjs",
    "db:migrate": "node scripts/guard-db-target.mjs MISSING_TARGET",
    "db:migrate:dev": "node scripts/guard-db-target.mjs dev && npx supabase db push --linked",
    "db:migrate:prod": "node scripts/db-push-prod.mjs",
    "db:migrate:script": "node scripts/run-migration.mjs",
    "db:query:dev": "node scripts/guard-db-target.mjs dev && npx supabase db query --linked",
    "db:query:prod": "node scripts/guard-db-target.mjs prod && npx supabase db query --linked",
    "db:push:prod": "node scripts/db-push-prod.mjs",
    "cleanup:e2e-orphans": "node scripts/cleanup-e2e-orphans.mjs",
    "cron:resources": "node scripts/trigger-resources-crons.mjs",
    "smoke:resources-hub": "node scripts/smoke-resources-hub.mjs",
    "audit:resources-hub": "node scripts/audit-resources-hub.mjs",
    "audit:hub-locales": "node scripts/audit-hub-localization-titles.mjs",
    "audit:hub-locales:coverage": "node scripts/audit-hub-localization-titles.mjs --locale-coverage",
    "audit:hub-locales:fail": "node scripts/audit-hub-localization-titles.mjs --fail",
    "fix:hub-locales": "node scripts/fix-hub-localization-titles.mjs",
    "insert:hub-locales": "node scripts/insert-missing-hub-localizations.mjs",
    "verify:app-store-url": "node scripts/verify-app-store-url.mjs",
    "add:admin-user": "node scripts/add-admin-user.mjs",
    "puppeteer:admin": "node scripts/puppeteer-admin-login.mjs",
    "puppeteer:reset-rebuild": "node scripts/puppeteer-reset-rebuild.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@next/third-parties": "^16.2.2",
    "@preact/signals": "^2.9.0",
    "@react-pdf/renderer": "^4.0.0",
    "@shopify/polaris": "^13.0.0",
    "@shopify/shopify-api": "^11.0.0",
    "@shopify/ui-extensions": "2026.4.0",
    "@shopify/web-pixels-extension": "^2.18.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/typography": "^0.5.19",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "^15.0.0",
    "next-intl": "^4.8.3",
    "preact": "^10.29.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resend": "^6.9.3",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.3.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "pg": "^8.18.0",
    "postcss": "^8.5.6",
    "puppeteer": "^23.11.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.5.0",
    "vercel": "^50.28.0",
    "vitest": "^2.0.0"
  }
}
