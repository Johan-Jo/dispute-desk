{
  "$comment": "Concept → list of i18n key paths that MUST resolve to the same string per locale. The CI guardrail (scripts/verify-i18n-equivalences.mjs) flags divergence. This is the structural defence against the kind of bug the user caught on 2026-05-25: 'Bedräglig' in one namespace, 'Bedräglig transaktion' in another, and 'Obehörig transaktion' (my mistake) in a third — all three describing the same FRAUDULENT concept.",

  "case_strength_strong": {
    "description": "Strong case-strength label, used as a pill / header subtitle. ONE string per locale.",
    "paths": [
      "disputes.caseStrength.strong",
      "disputes.workspaceShell.strengthLabel.strong"
    ]
  },
  "case_strength_moderate": {
    "description": "Moderate case-strength label. The 2026-05-25 corrections set this to e.g. 'Delvis stärkt ärende' (sv).",
    "paths": [
      "disputes.caseStrength.moderate",
      "disputes.workspaceShell.strengthLabel.moderate"
    ]
  },
  "case_strength_weak": {
    "description": "Weak case-strength label.",
    "paths": [
      "disputes.caseStrength.weak",
      "disputes.workspaceShell.strengthLabel.weak"
    ]
  },

