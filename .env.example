# ── Environment identity (Phase 0 — dev/prod split) ──────
# APP_ENV is the single source of truth that gates every dev/prod safety
# rule in lib/env/build-identity.ts + lib/env/runtime-identity.ts.
# Valid values: development | production.
# Leave unset locally until you've gone through Phase 0; the verifier is
# tolerant of an unset APP_ENV (see scripts/verify-env-identity.mjs).
# APP_ENV=development
#
# Cron auth gate (lib/cron/envGate.ts). Dev default: false → every cron
# route returns 204. Set true on prod. CRON_ENABLED_DEV_OVERRIDE=true is
# the deliberate dev opt-in if you need to exercise cron locally.
# CRON_ENABLED=false
# CRON_ENABLED_DEV_OVERRIDE=false
#
# Email-send master switch. When false (dev default), no transactional
# emails leave the process even if RESEND_API_KEY is set.
# EMAIL_SEND_ENABLED=false
#
# ── Per-environment local secret files ──────
# This file (.env.example) is committed. Real secrets live in two
# gitignored files (both match the .env*.local rule):
#
#   .env.local                — default for `npm run dev` / vitest /
#                               local tooling. Dev-pointing creds.
#   .env.production.local     — prod creds for the manual cutover/migration
#                               scripts only (e.g. scripts/db-push-prod.mjs,
#                               scripts/verify-supabase-migration.mjs).
#                               Loaded only when a script explicitly does
#                               `dotenv.config({ path: ".env.production.local" })`.
#                               `npm run dev` does NOT read it.
#
# Never paste secrets in chat, PRs, or commit messages. Pro project ref
# is a public identifier and may be recorded in code.

# ── Shopify ──────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Must match shopify.app.toml [access_scopes].scopes exactly (a drift-guard test enforces this).
SHOPIFY_SCOPES=read_all_orders,read_customer_events,read_customers,read_fulfillments,read_legal_policies,read_orders,read_products,read_shipping,read_shopify_payments_dispute_evidences,read_shopify_payments_dispute_file_uploads,read_shopify_payments_disputes,write_pixels,write_shopify_payments_dispute_evidences,write_shopify_payments_dispute_file_uploads
SHOPIFY_APP_URL=https://your-app.vercel.app
# Public Shopify App Store listing URL (Resources hub primary CTA). Copy the exact URL from
# Shopify Partners → your app → Distribution after the app is listed. If unset, the CTA points to
# /auth/sign-up on this site (see lib/marketing/shopifyInstallUrl.ts) so links never 404.
# NEXT_PUBLIC_SHOPIFY_APP_STORE_URL=https://apps.shopify.com/your-handle-from-partners

# Pin GraphQL Admin API version (default 2026-01)
SHOPIFY_API_VERSION=2026-01

# ── Analytics (optional) ─────────────────────────────────
# Google Analytics 4 measurement ID (Consent Mode v2; defaults denied until accepted on marketing).
# If unset or blank, the app defaults to G-MN5KDFQMMX (see app/layout.tsx). Optional on Vercel for explicit prod config.
# NEXT_PUBLIC_GA_ID=G-MN5KDFQMMX

# Real dispute generator (npm run seed:real-disputes). Uses SHOPIFY_API_KEY + SHOPIFY_API_SECRET (same as app) for tagging if SHOPIFY_ADMIN_TOKEN not set.
# SHOPIFY_STOREFRONT_DOMAIN=https://your-store.myshopify.com
# SHOPIFY_PAYMENTS_TEST_MODE_ACK=true
# STOREFRONT_PASSWORD=
# USE_SYSTEM_CHROME: script prefers installed Chrome by default; set false to force bundled Chromium

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Send Email Auth Hook (https://disputedesk.app/api/auth/email-hook): copy the exact hook secret from
# Dashboard → Authentication → Hooks → Send Email. Required in production when that hook is enabled.
# SUPABASE_AUTH_HOOK_SECRET=v1,whsec_...
# Auth → URL Configuration: add redirect URLs for Supabase Auth (Dashboard), e.g.:
#   {SHOPIFY_APP_URL}/auth/open-in-shopify   — post “Continue with Shopify” OAuth (magic link / action_link landing)
# Migrations: primary path is Supabase CLI (`npm run db:migrate` = `npx supabase db push` after `supabase login` + `supabase link`). No extra env vars needed beyond SUPABASE_* above.
# Optional — only for `npm run db:migrate:script` (Node script + `_migrations` table) if you cannot use the CLI:
# SUPABASE_URL_POSTGRES=postgresql://postgres:YOUR_PASSWORD@db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=

# ── Token Encryption (AES-256-GCM) ─────────────────────
# V1 key (hex-encoded 32-byte key). Add V2, V3… for rotation.
TOKEN_ENCRYPTION_KEY_V1=
# Backward-compat alias — points to same value as V1
TOKEN_ENCRYPTION_KEY=${TOKEN_ENCRYPTION_KEY_V1}

# ── Admin smoke / E2E (optional, dev only) ──────────────
# Portal user that has a row in internal_admin_grants (same email/password as /auth/sign-in).
# ADMIN_SMOKE_EMAIL=
# ADMIN_SMOKE_PASSWORD=

# ── Jobs / Cron ─────────────────────────────────────────
# Shared secret for cron routes (/api/jobs/worker, /api/cron/*). Generate with openssl rand -hex 32;
# set the same value in Vercel env so scheduled crons authenticate (Authorization: Bearer).
CRON_SECRET=

# ── E2E Tests (Playwright) ──────────────────────────────
# Portal sign-in for E2E tests. User must have at least one connected shop.
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=

# ── Email (Resend) ──────────────────────────────────────
# Required to send transactional emails (welcome, Resources Hub autopilot publish notifications, etc.). Use a verified domain in production.
# Autopilot “notification email” is configured in Admin → Resources → Settings (cms_settings), not here.
RESEND_API_KEY=
# From address. Use verified sending subdomain (mail.disputedesk.app). Override if needed.
# Default in code: DisputeDesk <notifications@mail.disputedesk.app>
EMAIL_FROM=DisputeDesk <notifications@mail.disputedesk.app>

# ── App URL (for email links, sitemap, SEO) ─────────────
# Public marketing site — set on every Vercel environment so emails never use a preview *.vercel.app host.
# NEXT_PUBLIC_APP_URL=https://disputedesk.app
# Optional server-only duplicate for transactional emails if NEXT_PUBLIC is unset:
# PUBLIC_CANONICAL_URL=https://disputedesk.app

# ── Cal.com (demo booking) ─────────────────────────────────
# Server-only API key for Cal.com. The client-side embed uses the public event slug.
# CAL_API_KEY=cal_live_...

# ── Resources hub: featured-image backfill (Pexels API) ─────
# PEXELS_API_KEY=...   # Required for npm run backfill:resources-images*

# ── AI Content Generation ──────────────────────────────────
# OPENAI_API_KEY=sk-...
# GENERATION_MODEL=gpt-4o          # Optional, defaults to gpt-4o
# GENERATION_ENABLED=true          # Feature flag, defaults to false

# ── Conditional file evidence layer ─────────────────────
# When "true", saveToShopifyJob runs decideFileAttachments, generates focused
# PDFs per native plan entry, REST-uploads them to Shopify's
# /shopify_payments/disputes/:id/dispute_file_uploads.json endpoint,
# persists the GIDs on pack_json.attachmentUploads for retry idempotency,
# and sets the matching *File fields on disputeEvidenceUpdate. Native-attached
# items have their corresponding link suppressed in uncategorizedText
# (Q2=A — native-only when attached). Default off.
#
# Plan: docs/plans/conditional_file_evidence_layer.plan.md
# Helper: lib/shopify/disputeFileUpload.ts
# Phase 0 results: docs/.shopify-evidence/phase-0-results/
# FILE_EVIDENCE_ATTACHMENTS_ENABLED=false

# ── Grounded Defence Package PDF Builder ─────────────────
# When "true", buildPackJob enqueues build_defence_package after pack reaches
# status=ready. The job classifies facts, calls Anthropic Claude for narrative
# prose, validates the output, renders a deterministic 15-section PDF, and
# uploads it to evidence-packs/{shopId}/{packId}/defence/v{n}/{iso}.pdf.
# When a final defence package exists, saveToShopifyJob swaps the
# uncategorizedFile buffer to the defence-package PDF. Default off.
# Plan: C:\Users\johan\.claude\plans\cozy-zooming-popcorn.md
# ENABLE_DEFENCE_PACKAGE_BUILDER=false
# Default Claude model for narrative generation. Sonnet 4.6 is the default;
# claude-haiku-4-5-20251001 for cheap regen; claude-opus-4-7 as escape hatch.
# DEFENCE_PACKAGE_DEFAULT_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY is reused from the AI Content Generation block above.

# ── SEO / IndexNow ──────────────────────────────────────
# Random 8-128 char string for IndexNow verification. Enables instant indexing on Bing/Yandex/Seznam.
# INDEXNOW_KEY=your-random-key-here

# ── IP enrichment (IPinfo) ──────────────────────────────
# Used by the Device & Location Consistency evidence block in
# fraud-family disputes. Collector degrades gracefully when unset —
# the evidence card renders as Missing and the Shopify submission
# uses a neutral fallback sentence.
# IPINFO_API_KEY=

# ── Observability ────────────────────────────────────────
# SENTRY_DSN=
# LOG_LEVEL=info

# ── Signal Radar (admin-only Shopify-merchant intelligence) ─────────
# Reddit has closed every direct path (anonymous .json blocked 2026-05-28,
# public .rss blocked 2026-06-04, Data API gated to moderation-only use
# cases). The Reddit source now reads Reddit THROUGH a web-search index —
# the search provider touches reddit.com, not us, so no IP block applies.
#
# PROD — Brave Search API (free 1,000 queries/month). Sign up at
# https://brave.com/search/api/ (free "Data for AI" tier), then:
# BRAVE_SEARCH_API_KEY=BSA...
# Works from Vercel datacenter IPs; gives freshness + real post dates.
# Hour-gated to {0,8,16} UTC (7 queries x 3 runs/day ~= 630/mo) to stay
# under the free cap. SIGNAL_RADAR_FORCE_FETCH=1 bypasses the gate.
# Without it, the adapter falls back to keyless DuckDuckGo lite, which is
# datacenter-IP-fragile (rate-limits to empty pages) — local dev only.
#
# LEGACY (dead in prod — every direct Reddit route is now blocked; kept
# for reference only): APIFY_API_TOKEN/APIFY_API_KEY (paid scraper),
# REDDIT_PROXY_URL + REDDIT_PROXY_SECRET (Cloudflare Worker .rss/.json).
#
# Optional: override the User-Agent passed to the search providers.
# REDDIT_USER_AGENT=DisputeDesk-SignalRadar/1.0 (contact: ops@example.com)
#
# Optional: pin classifier model (defaults to gpt-4o-mini-2024-07-18).
# Kept separate from GENERATION_MODEL so content-gen tuning doesn't drift
# the classifier.
# SIGNAL_RADAR_MODEL=gpt-4o-mini-2024-07-18
